{
  "entities": {
    "users": {
      "title": "User",
      "description": "Registered WattyBoon users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "followers": { "type": "array" },
        "following": { "type": "array" },
        "joinedDate": { "type": "string" },
        "library": { "type": "array" },
        "readingProgress": { "type": "array" },
        "customLists": { "type": "array" }
      },
      "required": ["id", "name", "username"]
    },
    "stories": {
      "title": "Story",
      "description": "Stories published or created by users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "coverUrl": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "publishedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "isDraft": { "type": "boolean" },
        "isPrivate": { "type": "boolean" },
        "isNsfw": { "type": "boolean" },
        "viewsCount": { "type": "number" },
        "readTime": { "type": "string" },
        "chapters": { "type": "array" },
        "comments": { "type": "array" },
        "likedBy": { "type": "array" },
        "rating": { "type": "number" }
      },
      "required": ["id", "title", "authorId"]
    },
    "notifications": {
      "title": "Notification",
      "description": "User notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "userId", "message"]
    },
    "messages": {
      "title": "Message",
      "description": "Direct messages between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "senderId", "receiverId", "content"]
    },
    "paragraphComments": {
      "title": "ParagraphComment",
      "description": "In-line paragraph comments on story chapters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storyId": { "type": "string" },
        "chapterIndex": { "type": "number" },
        "paragraphIndex": { "type": "number" },
        "userId": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["id", "storyId", "userId", "content"]
    },
    "forumTopics": {
      "title": "ForumTopic",
      "description": "Community forum topics and discussion threads",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "replies": { "type": "array" },
        "views": { "type": "number" },
        "likes": { "type": "number" }
      },
      "required": ["id", "title", "authorId", "content"]
    },
    "archivedStories": {
      "title": "ArchivedStory",
      "description": "Lost and deleted stories archived by community members with PDF files",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "originalAuthor": { "type": "string" },
        "chapterCount": { "type": "string" },
        "summary": { "type": "string" },
        "category": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "addedByUserId": { "type": "string" },
        "addedAt": { "type": "string" },
        "likes": { "type": "number" },
        "downloads": { "type": "number" }
      },
      "required": ["id", "title", "originalAuthor", "pdfUrl", "addedByUserId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "users" },
      "description": "User profiles and custom lists"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "stories" },
      "description": "Stories with chapters and comments"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "notifications" },
      "description": "User notifications"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "messages" },
      "description": "User direct messages"
    },
    "/paragraphComments/{commentId}": {
      "schema": { "$ref": "paragraphComments" },
      "description": "Paragraph level comments"
    },
    "/forumTopics/{topicId}": {
      "schema": { "$ref": "forumTopics" },
      "description": "Forum topics and community discussions"
    },
    "/archivedStories/{archiveId}": {
      "schema": { "$ref": "archivedStories" },
      "description": "Archived lost PDF stories uploaded by members"
    }
  }
}
